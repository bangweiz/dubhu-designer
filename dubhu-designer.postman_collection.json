		{
			"name": "Tools",
			"description": "Endpoints for creating, listing, retrieving, and updating tool specifications.",
			"item": [
				{
					"name": "Create Tool",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set(\"toolId\", jsonData.data.id);",
									"        console.log(\"Saved toolId:\", jsonData.data.id);",
									"    }",
									"    pm.collectionVariables.set(\"toolEtag\", pm.response.headers.get(\"ETag\"));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"http_request\",\n  \"description\": \"Performs HTTP requests to external APIs\",\n  \"inputs\": [\n    {\n      \"name\": \"url\",\n      \"type\": \"string\",\n      \"description\": \"Destination endpoint URL\",\n      \"required\": true\n    },\n    {\n      \"name\": \"method\",\n      \"type\": \"string\",\n      \"description\": \"HTTP method (e.g. GET, POST)\",\n      \"required\": false\n    }\n  ],\n  \"outputs\": [\n    {\n      \"name\": \"status_code\",\n      \"type\": \"number\",\n      \"description\": \"HTTP response status code\"\n    },\n    {\n      \"name\": \"response_body\",\n      \"type\": \"string\",\n      \"description\": \"Raw response payload\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/organisations/{{organisationId}}/tools",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"organisations",
								"{{organisationId}}",
								"tools"
							]
						},
						"description": "Creates a new tool specification and saves its ID and ETag."
					},
					"response": []
				},
